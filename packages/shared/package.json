{
  "name": "@arthora/shared",
  "version": "1.0.0",
  "description": "Shared types, Zod schemas, formatters, and utilities for Arthora",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
