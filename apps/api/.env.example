# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/finvest?retryWrites=true&w=majority
REDIS_URL=rediss://default:token@hostname.upstash.io:6380

# Firebase Admin SDK
FIREBASE_PROJECT_ID=finvest-XXXXX
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXXX@finvest-XXXXX.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=your_256_bit_random_hex_secret_here
JWT_REFRESH_SECRET=your_256_bit_random_hex_refresh_secret_here

# External APIs
GEMINI_API_KEY=your_gemini_api_key_here

# Server
PORT=4000
NODE_ENV=production
ALLOWED_ORIGINS=https://finvest.in,https://www.finvest.in

# Sentry (optional)
SENTRY_DSN=https://XXXXX@oXXXXX.ingest.sentry.io/XXXXX

# Admin
ADMIN_KEY=your_secure_admin_key_for_bull_board
