# Database
MONGODB_URI=mongodb://localhost:27017/arthora
REDIS_URL=redis://localhost:6379

# Firebase Admin SDK (optional for dev, required for Google OAuth token verification)
FIREBASE_PROJECT_ID=arthora-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-dev@arthora-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=""

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=arthora_dev_jwt_secret_minimum_32_characters_long_12345
JWT_REFRESH_SECRET=arthora_dev_jwt_refresh_secret_min_32_chars_12345

# External APIs
GEMINI_API_KEY=your_gemini_api_key_here

# Server
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://arthora.in,https://www.arthora.in

# Sentry (optional)
SENTRY_DSN=

# Admin
ADMIN_KEY=arthora_admin_secret_dev
