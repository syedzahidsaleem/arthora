{
  "name": "@arthora/api",
  "version": "1.0.0",
  "description": "Arthora API Server and Worker",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/main.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only --exit-child src/worker.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@arthora/shared": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.73.0",
    "@sparticuz/chromium": "^149.0.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.41.6",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "puppeteer-core": "^25.9.0",
    "sanitize-html": "^2.17.7",
    "simple-statistics": "^7.11.0",
    "technicalindicators": "^3.1.0",
    "uuid": "^14.0.2",
    "yahoo-finance2": "^4.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.19",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
