{
  "name": "arthora-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Arthora - AI-guided investment research platform for Indian retail investors",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:api": "pnpm --filter @arthora/api run dev",
    "dev:web": "pnpm --filter @arthora/web run dev",
    "dev:worker": "pnpm --filter @arthora/api run dev:worker",
    "build": "pnpm --filter @arthora/shared run build && pnpm --filter @arthora/api run build && pnpm --filter @arthora/web run build",
    "type-check": "pnpm -r run type-check",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^8.57.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
